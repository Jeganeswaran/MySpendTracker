{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@api": ["./src/api"],
      "@api/*": ["./src/api/*"],

      "@assets": ["./src/assets"],
      "@assets/*": ["./src/assets/*"],

      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"],

      "@constants": ["./src/constants"],
      "@constants/*": ["./src/constants/*"],

      "@hooks": ["./src/hooks"],
      "@hooks/*": ["./src/hooks/*"],

      "@navigation": ["./src/navigation"],
      "@navigation/*": ["./src/navigation/*"],

      "@screens": ["./src/screens"],
      "@screens/*": ["./src/screens/*"],

      "@stores": ["./src/stores"],
      "@stores/*": ["./src/stores/*"],

      "@theme": ["./src/theme"],
      "@theme/*": ["./src/theme/*"],

      "@app-types": ["./src/types"],
      "@app-types/*": ["./src/types/*"],

      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*"],

      "@lib": ["./src/lib"],
      "@lib/*": ["./src/lib/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "**/android", "**/ios"]
}
